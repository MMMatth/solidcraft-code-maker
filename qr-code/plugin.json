{
  "id": "qr-code",
  "name": "QR Code",
  "version": "0.4.0",
  "description": "Puts a QR code on a plate or on a face of your model.",
  "capabilities": [
    "commands@0.2"
  ],
  "runtime": {
    "module": "qr-code.wasm",
    "commands": [
      "solid.box",
      "sketch.create",
      "sketch.line",
      "sketch.finish",
      "solid.extrude",
      "model.faces"
    ],
    "entries": [
      {
        "name": "qr",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "title": "Text or link",
              "default": "https://example.com",
              "maxLength": 500
            },
            "face": {
              "type": "array",
              "title": "Put it on a face (optional)",
              "description": "Click a flat face of your model. Leave empty to get a new plate.",
              "maxItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "face"
                ]
              }
            },
            "style": {
              "type": "string",
              "title": "Style",
              "default": "raised",
              "oneOf": [
                {
                  "const": "raised",
                  "title": "Raised"
                },
                {
                  "const": "engraved",
                  "title": "Engraved"
                }
              ]
            },
            "size": {
              "type": "number",
              "title": "Size",
              "default": 30,
              "minimum": 5,
              "maximum": 500,
              "unit": "mm"
            },
            "height": {
              "type": "number",
              "title": "Height or depth",
              "default": 0.6,
              "minimum": 0.1,
              "maximum": 20,
              "unit": "mm"
            },
            "offset": {
              "type": "number",
              "title": "Move away from the face",
              "description": "Positive moves the code off the face, negative sinks it into the model. Only with a face.",
              "default": 0,
              "minimum": -1000,
              "maximum": 1000,
              "unit": "mm"
            }
          }
        },
        "slots": [
          {
            "kind": "ribbon",
            "name": "Model"
          }
        ]
      }
    ],
    "limits": {
      "fuel": 5000000000,
      "memory_mib": 32,
      "deadline_ms": 20000
    }
  }
}