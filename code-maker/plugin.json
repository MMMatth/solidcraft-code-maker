{
  "id": "code-maker",
  "name": "Code Maker",
  "version": "0.7.1",
  "description": "Puts a QR code, a barcode, an ArUco marker or an AprilTag on a plate or on a face of your model.",
  "capabilities": [
    "commands@0.2"
  ],
  "runtime": {
    "module": "code-maker.wasm",
    "commands": [
      "solid.box",
      "sketch.create",
      "sketch.line",
      "sketch.finish",
      "solid.extrude",
      "solid.combine",
      "model.faces",
      "appearance.assign",
      "document.inspect"
    ],
    "entries": [
      {
        "name": "code",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "x-solidcraft-field-order": "declared",
          "x-solidcraft-icon": "i/code.svg",
          "properties": {
            "kind": {
              "type": "string",
              "title": "Type of code",
              "default": "qr",
              "description": "A QR code or another 2D code, a barcode, or an ArUco marker or AprilTag (the markers cameras and robots track).",
              "oneOf": [
                {
                  "const": "qr",
                  "title": "QR code"
                },
                {
                  "const": "ean13",
                  "title": "Barcode: EAN-13"
                },
                {
                  "const": "code128",
                  "title": "Barcode: Code 128"
                },
                {
                  "const": "upca",
                  "title": "Barcode: UPC-A"
                },
                {
                  "const": "datamatrix",
                  "title": "Data Matrix"
                },
                {
                  "const": "code39",
                  "title": "Barcode: Code 39"
                },
                {
                  "const": "pdf417",
                  "title": "PDF417"
                },
                {
                  "const": "aztec",
                  "title": "Aztec code"
                },
                {
                  "const": "itf",
                  "title": "Barcode: ITF"
                },
                {
                  "const": "ean8",
                  "title": "Barcode: EAN-8"
                },
                {
                  "const": "upce",
                  "title": "Barcode: UPC-E"
                },
                {
                  "const": "codabar",
                  "title": "Barcode: Codabar"
                },
                {
                  "const": "code93",
                  "title": "Barcode: Code 93"
                },
                {
                  "const": "aruco",
                  "title": "ArUco marker"
                },
                {
                  "const": "apriltag",
                  "title": "AprilTag"
                }
              ]
            },
            "text": {
              "type": "string",
              "title": "Text or link",
              "default": "https://example.com",
              "maxLength": 500,
              "description": "What the code says (at most 500 characters).",
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "kind",
                  "in": [
                    "aruco",
                    "apriltag",
                    "code128",
                    "ean13",
                    "ean8",
                    "upca",
                    "upce",
                    "itf",
                    "code39",
                    "code93",
                    "codabar"
                  ]
                }
              }
            },
            "code128_text": {
              "type": "string",
              "title": "Code 128 text",
              "default": "ABC-123456",
              "maxLength": 500,
              "description": "Plain ASCII text: letters, digits and signs. The longer it is, the wider the barcode.",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "code128"
              }
            },
            "qr_correction": {
              "type": "string",
              "title": "Error correction",
              "default": "medium",
              "description": "QR code only. More correction reads through more damage or dirt, in a denser code (smaller modules for the same size).",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "qr"
              },
              "oneOf": [
                {
                  "const": "low",
                  "title": "Low (7%)"
                },
                {
                  "const": "medium",
                  "title": "Medium (15%)"
                },
                {
                  "const": "quartile",
                  "title": "Quartile (25%)"
                },
                {
                  "const": "high",
                  "title": "High (30%)"
                }
              ]
            },
            "ean13_text": {
              "type": "string",
              "title": "EAN-13 number",
              "default": "5901234123457",
              "maxLength": 500,
              "description": "12 or 13 digits. With 12, the check digit is added; with 13, the last one must be right. Spaces and hyphens are fine.",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "ean13"
              }
            },
            "ean8_text": {
              "type": "string",
              "title": "EAN-8 number",
              "default": "96385074",
              "maxLength": 500,
              "description": "7 or 8 digits. With 7, the check digit is added; with 8, the last one must be right.",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "ean8"
              }
            },
            "upca_text": {
              "type": "string",
              "title": "UPC-A number",
              "default": "036000291452",
              "maxLength": 500,
              "description": "11 or 12 digits. With 11, the check digit is added; with 12, the last one must be right.",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "upca"
              }
            },
            "upce_text": {
              "type": "string",
              "title": "UPC-E number",
              "default": "01234565",
              "maxLength": 500,
              "description": "7 or 8 digits, starting with 0 or 1.",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "upce"
              }
            },
            "itf_text": {
              "type": "string",
              "title": "ITF number",
              "default": "123456789012",
              "maxLength": 500,
              "description": "Digits only, an even number of them (add a 0 in front if odd).",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "itf"
              }
            },
            "code39_text": {
              "type": "string",
              "title": "Code 39 text",
              "default": "ABC-1234",
              "maxLength": 500,
              "description": "Capital letters A to Z, digits, space and - . $ / + %",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "code39"
              }
            },
            "code93_text": {
              "type": "string",
              "title": "Code 93 text",
              "default": "ABC1234",
              "maxLength": 500,
              "description": "Capital letters A to Z, digits, space and - . $ / + %",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "code93"
              }
            },
            "codabar_text": {
              "type": "string",
              "title": "Codabar text",
              "default": "A12345B",
              "maxLength": 500,
              "description": "Digits and - $ : / . + between a start and a stop letter A to D.",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "codabar"
              }
            },
            "aruco_dictionary": {
              "type": "string",
              "title": "Family",
              "default": "4x4_50",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "aruco"
              },
              "oneOf": [
                {
                  "const": "4x4_50",
                  "title": "ArUco 4x4"
                },
                {
                  "const": "5x5_100",
                  "title": "ArUco 5x5"
                },
                {
                  "const": "6x6_250",
                  "title": "ArUco 6x6"
                },
                {
                  "const": "original",
                  "title": "ArUco original"
                }
              ]
            },
            "apriltag_dictionary": {
              "type": "string",
              "title": "Family",
              "default": "36h11",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "eq": "apriltag"
              },
              "oneOf": [
                {
                  "const": "36h11",
                  "title": "AprilTag 36h11 (the usual one)"
                },
                {
                  "const": "16h5",
                  "title": "AprilTag 16h5"
                },
                {
                  "const": "standard_41h12",
                  "title": "AprilTag Standard 41h12"
                }
              ]
            },
            "id": {
              "type": "integer",
              "title": "Marker number",
              "default": 0,
              "minimum": 0,
              "maximum": 1023,
              "description": "Only for an ArUco marker or an AprilTag: its number in the dictionary (0 is fine).",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "in": [
                  "aruco",
                  "apriltag"
                ]
              }
            },
            "face": {
              "type": "array",
              "title": "Put it on a face (optional)",
              "description": "Click a flat face of your model. Leave empty to get a new plate.",
              "maxItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "face"
                ]
              }
            },
            "style": {
              "type": "string",
              "title": "Style",
              "default": "raised",
              "oneOf": [
                {
                  "const": "raised",
                  "title": "Raised"
                },
                {
                  "const": "engraved",
                  "title": "Engraved"
                },
                {
                  "const": "inlay",
                  "title": "Inlay (engraved, filled by a body of its own)"
                }
              ],
              "description": "Raised from the surface, engraved into it, or inlay: engraved and filled flush by a separate body, so a slicer can print it in another filament."
            },
            "own_body": {
              "type": "boolean",
              "title": "Code as its own body",
              "default": false,
              "description": "Makes the raised code a body of its own instead of part of the plate or face, so a slicer can give it another filament. An inlay is always its own body."
            },
            "color": {
              "type": "string",
              "title": "Colour of the code",
              "default": "black",
              "description": "Colours the raised modules (or the engraving) so the code stands out. Pick No colour to keep the colour of the part.",
              "oneOf": [
                {
                  "const": "black",
                  "title": "Black"
                },
                {
                  "const": "blue",
                  "title": "Blue"
                },
                {
                  "const": "red",
                  "title": "Red"
                },
                {
                  "const": "green",
                  "title": "Green"
                },
                {
                  "const": "orange",
                  "title": "Orange"
                },
                {
                  "const": "yellow",
                  "title": "Yellow"
                },
                {
                  "const": "white",
                  "title": "White"
                },
                {
                  "const": "none",
                  "title": "No colour"
                }
              ]
            },
            "size": {
              "type": "number",
              "title": "Size",
              "default": 30,
              "minimum": 5,
              "maximum": 500,
              "unit": "mm",
              "x-solidcraft-defaults": [
                {
                  "when": {
                    "field": "kind",
                    "eq": "qr"
                  },
                  "value": 30
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "datamatrix"
                  },
                  "value": 30
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "aztec"
                  },
                  "value": 30
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "pdf417"
                  },
                  "value": 90
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "code128"
                  },
                  "value": 80
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "code39"
                  },
                  "value": 85
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "code93"
                  },
                  "value": 70
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "itf"
                  },
                  "value": 80
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "codabar"
                  },
                  "value": 50
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "ean13"
                  },
                  "value": 65
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "ean8"
                  },
                  "value": 50
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "upca"
                  },
                  "value": 65
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "upce"
                  },
                  "value": 45
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "aruco"
                  },
                  "value": 30
                },
                {
                  "when": {
                    "field": "kind",
                    "eq": "apriltag"
                  },
                  "value": 30
                }
              ],
              "description": "Width of the whole code. Too small to print (modules under 0.4 mm) and it is raised to the least that prints well; the result says so."
            },
            "bar_height": {
              "type": "number",
              "title": "Bar height",
              "default": 15,
              "minimum": 3,
              "maximum": 200,
              "unit": "mm",
              "description": "Only for a barcode: how tall the bars are. Size is the width of the whole barcode.",
              "x-solidcraft-visible-when": {
                "field": "kind",
                "in": [
                  "code128",
                  "ean13",
                  "upca",
                  "ean8",
                  "upce",
                  "code39",
                  "code93",
                  "itf",
                  "codabar"
                ]
              }
            },
            "height": {
              "type": "number",
              "title": "Height or depth",
              "default": 0.6,
              "minimum": 0.1,
              "maximum": 20,
              "unit": "mm"
            },
            "move_x": {
              "type": "number",
              "title": "Move X",
              "default": 0,
              "minimum": -100000,
              "maximum": 100000,
              "unit": "mm",
              "description": "Moves the code along the world X axis. On a face, keep the move along the face to stay on it."
            },
            "move_y": {
              "type": "number",
              "title": "Move Y",
              "default": 0,
              "minimum": -100000,
              "maximum": 100000,
              "unit": "mm",
              "description": "Moves the code along the world Y axis. On a face, keep the move along the face to stay on it."
            },
            "move_z": {
              "type": "number",
              "title": "Move Z",
              "default": 0,
              "minimum": -100000,
              "maximum": 100000,
              "unit": "mm",
              "description": "Moves the code along the world Z axis. On a face, keep the move along the face to stay on it."
            },
            "move_axes": {
              "type": "string",
              "title": "Move along",
              "default": "world",
              "description": "World axes, or the face's own: X to the right, Y up and Z out of the face (for a face that is not level). Only with a face.",
              "oneOf": [
                {
                  "const": "world",
                  "title": "World axes"
                },
                {
                  "const": "face",
                  "title": "Face axes"
                }
              ]
            },
            "rotation": {
              "type": "number",
              "title": "Rotate",
              "default": 0,
              "minimum": -180,
              "maximum": 180,
              "unit": "deg",
              "description": "Turns the code on the face, counter-clockwise as you look at it. Only with a face."
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Code"
          },
          {
            "kind": "ribbon",
            "name": "Code"
          }
        ]
      }
    ],
    "limits": {
      "fuel": 5000000000,
      "memory_mib": 32,
      "deadline_ms": 30000
    }
  }
}
